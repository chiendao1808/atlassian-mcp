schema_version: 1
name: wf_bug_resolving
display_name: Bug Resolution
description: Resolve a verified defect or regression through bug clarification, impact exploration, evidence-based root-cause
  assessment, approved fixing, verification, and review.
initial_state: BUG_ANALYSIS
terminal_states:
- COMPLETED
- CANCELLED
runtime_state_template:
  workflow_id: null
  workflow_name: wf_bug_resolving
  status: running
  current_state: BUG_ANALYSIS
  previous_state: null
  active_agent: req_analyzer
  request:
    summary: null
    classification: bug_fix
    source_refs: []
    bug_id: null
    priority: null
  bug:
    reproduction_steps: []
    actual_result: null
    expected_result: null
    environment: null
    facts: []
    clues: []
    hypotheses: []
    impact: []
  artifacts:
    bug_brief: null
    supplied_fix_plan: null
    plan_review_report: null
    exploration_report: null
    root_cause_report: null
    quick_fix_brief: null
    fix_plan: null
    implementation_report: null
    documentation_updates: []
    comment_coverage: []
    review_report: null
  approval:
    required: false
    status: not_required
    requested_scope: []
    approved_scope: []
  execution:
    retry_count: 0
    review_cycle: 0
    max_review_cycles: 3
    blocker: null
  metadata:
    raw_context:
      user_prompt: null
      source_snapshots: []
      agent_outputs: []
    additional_context:
      user_clarifications: []
      repository_rules: []
      project_skills: []
      constraints: []
      notes: []
      workflow_selection: {}
    tags: []
    correlation: {}
    updated_at: null
  history: []
  planning:
    complexity: unknown
    risk_level: unknown
    mode: undecided
    rationale: []
    escalation_triggers: []
    execution_profile:
      preferred_model: null
      preferred_reasoning_effort: null
      selected_agent_type: null
      fallback_agent_type: planner
states:
  BUG_ANALYSIS:
    agent: req_analyzer
    purpose: Build a normalized bug brief and review any supplied fix or implementation plan for reuse.
    expected_outputs:
    - bug_brief
    - facts
    - clues
    - hypotheses
    - blocking_questions
    - planning_classification_hint
    - supplied_plan_review
    - plan_reuse_recommendation
    allowed_events:
    - bug_brief_ready
    - quick_fix_candidate
    - clarification_needed
    - blocked
    - cancelled
    metadata:
      raw_context_keys:
      - user_prompt
      - source_snapshots
      - agent_outputs
      additional_context_keys:
      - user_clarifications
      - constraints
      - workflow_selection
  CLARIFICATION_REQUIRED:
    agent: main
    purpose: Obtain missing reproduction, expected behavior, environment, scope, or access information.
    expected_outputs:
    - user_clarifications
    allowed_events:
    - clarification_received
    - cancelled
    metadata:
      raw_context_keys:
      - user_prompt
      additional_context_keys:
      - user_clarifications
      - notes
  IMPACT_EXPLORATION:
    agent: explorer
    purpose: Trace affected code paths, data flows, contracts, dependencies, and blast radius using indexed tools when available.
    expected_outputs:
    - exploration_report
    - affected_symbols
    - impact_map
    - evidence_gaps
    allowed_events:
    - impact_mapped
    - blocked
    metadata:
      raw_context_keys:
      - agent_outputs
      additional_context_keys:
      - repository_rules
      - project_skills
      - constraints
      - notes
  ROOT_CAUSE_ASSESSMENT:
    agent: explorer
    purpose: Evaluate root-cause hypotheses against codebase and bug evidence without modifying the workspace.
    expected_outputs:
    - root_cause_report
    - supported_hypotheses
    - rejected_hypotheses
    - remaining_gaps
    allowed_events:
    - evidence_sufficient
    - more_evidence_needed
    - user_evidence_needed
    - blocked
    metadata:
      raw_context_keys:
      - source_snapshots
      - agent_outputs
      additional_context_keys:
      - repository_rules
      - project_skills
      - user_clarifications
      - constraints
      - notes
  COMPLEXITY_ASSESSMENT:
    agent: main
    purpose: Classify the verified bug by change complexity and operational risk, then select a lightweight or full planning
      path.
    expected_outputs:
    - planning_complexity
    - risk_level
    - planning_mode
    - planning_rationale
    - escalation_triggers
    - execution_profile
    - supplied_plan_validation
    allowed_events:
    - quick_fix_selected
    - full_planning_selected
    - clarification_needed
    - blocked
    - provided_plan_ready
    metadata:
      raw_context_keys:
      - source_snapshots
      - agent_outputs
      additional_context_keys:
      - repository_rules
      - project_skills
      - user_clarifications
      - constraints
      - notes
  QUICK_FIX_PLANNING:
    agent: planner
    purpose: Create or revise a concise, implementation-ready quick-fix brief for a deterministic, localized, low-risk bug
      without producing a full architecture plan.
    execution_profile:
      mode: lightweight
      preferred_model: sonnet
      preferred_reasoning_effort: medium
      fallback_agent_type: planner
      note: Use a matching lightweight planner profile or per-dispatch override when available; otherwise use the canonical
        planner with this constrained output contract.
    expected_outputs:
    - quick_fix_brief
    - requested_fix_scope
    - expected_code_change
    - validation_strategy
    - risk_check
    allowed_events:
    - quick_plan_ready
    - escalate_to_full_planning
    - clarification_needed
    - blocked
    metadata:
      raw_context_keys:
      - agent_outputs
      additional_context_keys:
      - repository_rules
      - project_skills
      - constraints
      - notes
  FIX_PLANNING:
    agent: planner
    purpose: Create or revise the smallest safe fix plan grounded in the confirmed bug contract, impact map, and root-cause
      evidence.
    expected_outputs:
    - fix_plan
    - requested_fix_scope
    - validation_strategy
    - plan_questions
    allowed_events:
    - plan_ready
    - clarification_needed
    - blocked
    metadata:
      raw_context_keys:
      - agent_outputs
      additional_context_keys:
      - repository_rules
      - project_skills
      - constraints
      - notes
    execution_profile:
      mode: full
      preferred_model: opus
      preferred_reasoning_effort: high
      fallback_agent_type: planner
  PLAN_REVIEW:
    agent: main
    purpose: Present the reused, revised, or newly created fix plan, expected behavior, risks, validation, and scope for explicit
      user approval.
    approval_required: true
    expected_outputs:
    - plan_approval_status
    - approved_scope
    allowed_events:
    - approved
    - changes_requested
    - rejected
    metadata:
      raw_context_keys:
      - agent_outputs
      additional_context_keys:
      - user_clarifications
      - constraints
      - notes
  IMPLEMENTATION:
    agent: implementer
    purpose: Implement the approved fix without expanding scope.
    expected_outputs:
    - changed_files
    - implementation_report
    - documentation_updates
    - comment_coverage
    allowed_events:
    - fix_ready
    - blocked
    metadata:
      raw_context_keys:
      - agent_outputs
      additional_context_keys:
      - repository_rules
      - project_skills
      - constraints
      - notes
  SELF_VERIFICATION:
    agent: implementer
    purpose: Review the diff and run the narrowest appropriate compile, build, or focused behavior validation allowed by the
      approved scope.
    expected_outputs:
    - diff_summary
    - verification_commands
    - verification_result
    - documentation_comment_check
    allowed_events:
    - verification_passed
    - verification_failed
    - blocked
    metadata:
      raw_context_keys:
      - agent_outputs
      additional_context_keys:
      - constraints
      - notes
  CODE_REVIEW:
    agent: code_reviewer
    purpose: Review the fix for correctness, regression risk, side effects, compatibility, and compliance with project rules.
    expected_outputs:
    - review_report
    - review_findings
    - review_summary
    - documentation_comment_findings
    allowed_events:
    - review_accepted
    - findings_found
    - blocked
    metadata:
      raw_context_keys:
      - agent_outputs
      additional_context_keys:
      - repository_rules
      - project_skills
      - constraints
      - notes
  REMEDIATION:
    agent: implementer
    purpose: Address accepted review findings within the approved remediation scope.
    expected_outputs:
    - remediated_findings
    - remediation_report
    - documentation_updates
    - comment_coverage
    allowed_events:
    - remediation_ready
    - blocked
    metadata:
      raw_context_keys:
      - agent_outputs
      additional_context_keys:
      - constraints
      - notes
  BLOCKED:
    agent: main
    purpose: Resolve missing evidence, access, tooling, approval, or scope blockers while preserving current bug context.
    expected_outputs:
    - blocker_resolution
    - resume_target
    allowed_events:
    - resume_analysis
    - resume_exploration
    - resume_implementation
    - resume_complexity_assessment
    - resume_quick_planning
    - resume_full_planning
    - cancelled
    metadata:
      raw_context_keys:
      - agent_outputs
      additional_context_keys:
      - user_clarifications
      - constraints
      - notes
  COMPLETED:
    agent: main
    purpose: Record the resolved behavior, changed scope, verification, review outcome, and residual risks.
    terminal: true
    metadata:
      raw_context_keys:
      - agent_outputs
      additional_context_keys:
      - constraints
      - notes
  CANCELLED:
    agent: main
    purpose: Record cancellation or rejection without further modification.
    terminal: true
    metadata:
      raw_context_keys: []
      additional_context_keys:
      - notes
transitions:
- from: BUG_ANALYSIS
  event: clarification_needed
  to: CLARIFICATION_REQUIRED
  guard: blocking_bug_information_missing
- from: CLARIFICATION_REQUIRED
  event: clarification_received
  to: BUG_ANALYSIS
  guard: user_response_recorded_and_resume_state_is_bug_analysis
- from: BUG_ANALYSIS
  event: bug_brief_ready
  to: IMPACT_EXPLORATION
  guard: actual_and_expected_behavior_sufficiently_defined
- from: BUG_ANALYSIS
  event: quick_fix_candidate
  to: COMPLEXITY_ASSESSMENT
  guard: deterministic_local_issue_with_verified_location_expected_behavior_and_change_condition
- from: IMPACT_EXPLORATION
  event: impact_mapped
  to: ROOT_CAUSE_ASSESSMENT
  guard: affected_paths_and_dependencies_identified
- from: ROOT_CAUSE_ASSESSMENT
  event: more_evidence_needed
  to: IMPACT_EXPLORATION
  guard: additional_codebase_evidence_can_resolve_gap
- from: ROOT_CAUSE_ASSESSMENT
  event: user_evidence_needed
  to: CLARIFICATION_REQUIRED
  guard: missing_external_or_reproduction_evidence
- from: ROOT_CAUSE_ASSESSMENT
  event: evidence_sufficient
  to: COMPLEXITY_ASSESSMENT
  guard: root_cause_or_fix_condition_supported_by_evidence
- from: COMPLEXITY_ASSESSMENT
  event: quick_fix_selected
  to: QUICK_FIX_PLANNING
  guard: all_quick_fix_eligibility_checks_pass_and_no_escalation_trigger_present
- from: COMPLEXITY_ASSESSMENT
  event: full_planning_selected
  to: FIX_PLANNING
  guard: complexity_or_risk_requires_full_planning
- from: COMPLEXITY_ASSESSMENT
  event: provided_plan_ready
  to: PLAN_REVIEW
  guard: supplied_plan_review_recommends_reuse_and_verified_scope_root_cause_risk_and_validation_are_covered
- from: COMPLEXITY_ASSESSMENT
  event: clarification_needed
  to: CLARIFICATION_REQUIRED
  guard: planning_classification_depends_on_missing_information_and_resume_state_recorded
- from: COMPLEXITY_ASSESSMENT
  event: blocked
  to: BLOCKED
  guard: blocker_recorded
- from: QUICK_FIX_PLANNING
  event: quick_plan_ready
  to: PLAN_REVIEW
  guard: concise_scope_change_and_validation_are_complete_and_no_escalation_trigger_present
- from: QUICK_FIX_PLANNING
  event: escalate_to_full_planning
  to: FIX_PLANNING
  guard: new_cross_cutting_risk_or_scope_uncertainty_discovered
- from: QUICK_FIX_PLANNING
  event: clarification_needed
  to: CLARIFICATION_REQUIRED
  guard: blocking_quick_plan_question_present_and_resume_state_recorded
- from: QUICK_FIX_PLANNING
  event: blocked
  to: BLOCKED
  guard: blocker_recorded
- from: FIX_PLANNING
  event: plan_ready
  to: PLAN_REVIEW
  guard: no_blocking_plan_questions
- from: PLAN_REVIEW
  event: changes_requested
  to: QUICK_FIX_PLANNING
  guard: user_requested_plan_changes_and_planning_mode_is_quick_fix
- from: PLAN_REVIEW
  event: changes_requested
  to: FIX_PLANNING
  guard: user_requested_plan_changes_and_planning_mode_is_full
- from: PLAN_REVIEW
  event: approved
  to: IMPLEMENTATION
  guard: explicit_user_plan_approval_and_scope_recorded
- from: PLAN_REVIEW
  event: rejected
  to: CANCELLED
  guard: user_rejected_plan
- from: IMPLEMENTATION
  event: fix_ready
  to: SELF_VERIFICATION
  guard: approved_fix_applied_with_documentation_and_comment_coverage
- from: SELF_VERIFICATION
  event: verification_failed
  to: IMPLEMENTATION
  guard: failure_within_approved_scope
- from: SELF_VERIFICATION
  event: verification_passed
  to: CODE_REVIEW
  guard: diff_reviewed_validation_passed_and_documentation_comment_coverage_confirmed
- from: CODE_REVIEW
  event: findings_found
  to: REMEDIATION
  guard: accepted_actionable_findings_present
- from: CODE_REVIEW
  event: review_accepted
  to: COMPLETED
  guard: expected_behavior_restored_and_no_blocking_findings
- from: REMEDIATION
  event: remediation_ready
  to: SELF_VERIFICATION
  guard: accepted_findings_addressed_with_documentation_and_comment_coverage
- from: BUG_ANALYSIS
  event: blocked
  to: BLOCKED
  guard: blocker_recorded
- from: IMPACT_EXPLORATION
  event: blocked
  to: BLOCKED
  guard: blocker_recorded
- from: ROOT_CAUSE_ASSESSMENT
  event: blocked
  to: BLOCKED
  guard: blocker_recorded
- from: FIX_PLANNING
  event: blocked
  to: BLOCKED
  guard: blocker_recorded
- from: IMPLEMENTATION
  event: blocked
  to: BLOCKED
  guard: blocker_recorded
- from: SELF_VERIFICATION
  event: blocked
  to: BLOCKED
  guard: blocker_recorded
- from: CODE_REVIEW
  event: blocked
  to: BLOCKED
  guard: blocker_recorded
- from: REMEDIATION
  event: blocked
  to: BLOCKED
  guard: blocker_recorded
- from: BLOCKED
  event: resume_analysis
  to: BUG_ANALYSIS
  guard: analysis_blocker_resolved
- from: BLOCKED
  event: resume_exploration
  to: IMPACT_EXPLORATION
  guard: exploration_blocker_resolved
- from: BLOCKED
  event: resume_implementation
  to: IMPLEMENTATION
  guard: implementation_blocker_resolved_and_scope_approved
- from: CLARIFICATION_REQUIRED
  event: cancelled
  to: CANCELLED
  guard: user_cancelled
- from: BUG_ANALYSIS
  event: cancelled
  to: CANCELLED
  guard: user_cancelled
- from: FIX_PLANNING
  event: clarification_needed
  to: CLARIFICATION_REQUIRED
  guard: blocking_plan_questions_present_and_resume_state_recorded
- from: CLARIFICATION_REQUIRED
  event: clarification_received
  to: FIX_PLANNING
  guard: user_response_recorded_and_resume_state_is_fix_planning
- from: BLOCKED
  event: cancelled
  to: CANCELLED
  guard: user_cancelled
- from: CLARIFICATION_REQUIRED
  event: clarification_received
  to: COMPLEXITY_ASSESSMENT
  guard: user_response_recorded_and_resume_state_is_complexity_assessment
- from: CLARIFICATION_REQUIRED
  event: clarification_received
  to: QUICK_FIX_PLANNING
  guard: user_response_recorded_and_resume_state_is_quick_fix_planning
- from: BLOCKED
  event: resume_complexity_assessment
  to: COMPLEXITY_ASSESSMENT
  guard: classification_blocker_resolved
- from: BLOCKED
  event: resume_quick_planning
  to: QUICK_FIX_PLANNING
  guard: quick_planning_blocker_resolved
- from: BLOCKED
  event: resume_full_planning
  to: FIX_PLANNING
  guard: full_planning_blocker_resolved
